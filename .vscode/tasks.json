{
	// Taches de compilation uniquement (make / make re).
	// Le fichier .conf passe a ./webserv se change dans launch.json,
	// pas ici.
	"version": "2.0.0",
	"tasks": [
		{
			"label": "make",
			"type": "shell",
			"command": "make",
			"args": ["-j"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": ["$gcc"]
		},
		{
			"label": "make re",
			"type": "shell",
			"command": "make",
			"args": ["re", "-j"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"problemMatcher": ["$gcc"]
		}
	]
}
